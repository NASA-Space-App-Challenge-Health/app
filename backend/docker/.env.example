# Copy this file to backend/docker/.env before changing local defaults.
# compose.sh copies it for you on the first local run. Do not commit .env.
# The API image is built from backend/services/api. Keep API_CONTAINER_PORT
# equal to the port the process listens on (PORT, default 8000).
API_PORT=8080
API_CONTAINER_PORT=8000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=app
POSTGRES_USER=app
# Local-only default. Replace before using this stack beyond local development.
POSTGRES_PASSWORD=app
QUEUE_IMAGE=redis:7-alpine
