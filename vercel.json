{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build && python3 scripts/stage_vercel_public.py",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{data/**,docs/**,notebooks/**,**/*.png,**/*.csv,**/*.ipynb,**/*.db,.venv/**,**/tests/**,frontend/**,public/**,node_modules/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/predict", "destination": "/api/index" },
    { "source": "/predict/(.*)", "destination": "/api/index" },
    { "source": "/recommendations", "destination": "/api/index" },
    { "source": "/eda/(.*)", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/redoc", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/status", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" }
  ]
}
